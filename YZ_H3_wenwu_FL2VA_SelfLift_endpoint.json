{
  "kind": "comfyui",
  "schema_version": "1.0.0",
  "meta": {
    "name": "MiniMax H3 文武双全 FL2VA+SelfLift",
    "author": "ArcReel merge",
    "version": "1.0.0",
    "description": "FL2VA 首尾帧锁定 + SelfLiftH3Sampler 超分 + ChunkFeedForward/LowVRAMAttention 显存优化 + 7 LoRA"
  },
  "media_type": "video",
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "minimax_h3_hybrid_fl2va_ref2va_b25-49-int8.safetensors",
        "weight_dtype": "default"
      },
      "_meta": {
        "title": "H3 V2 fused base"
      }
    },
    "2": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "lora_name": "minimax_h3_dmad_full_dareties_v4_step600_comfy_fro.safetensors",
        "strength_model": 0.5
      },
      "_meta": {
        "title": "H3 FL2V turbo LoRA"
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "type": "minimax",
        "device": "default"
      },
      "_meta": {
        "title": "H3 Qwen3-VL encoder"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
      },
      "_meta": {
        "title": "H3 video VAE"
      }
    },
    "5": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
      },
      "_meta": {
        "title": "H3 audio VAE"
      }
    },
    "6": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "storyboards/E1S01_v1_20261016T194612.png"
      },
      "_meta": {
        "title": "ARCREEL:start_image"
      }
    },
    "7": {
      "class_type": "MiniMaxH3ImageToVideo",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "prompt": "",
        "width": 1248,
        "height": 704,
        "length": 217,
        "first_frame": [
          "6",
          0
        ],
        "last_frame": [
          "13",
          0
        ]
      },
      "_meta": {
        "title": "H3 i2v conditioning"
      }
    },
    "11": {
      "class_type": "MiniMaxH3AVDecodeT8",
      "inputs": {
        "av_latent": [
          "55",
          0
        ],
        "video_vae": [
          "4",
          0
        ],
        "audio_vae": [
          "5",
          0
        ]
      },
      "_meta": {
        "title": "AV decode"
      }
    },
    "12": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "images": [
          "11",
          0
        ],
        "audio": [
          "11",
          1
        ],
        "frame_rate": 24.0,
        "loop_count": 0,
        "filename_prefix": "arcreel_h3_i2va",
        "format": "video/h264-mp4",
        "pix_fmt": "yuv420p",
        "crf": 19,
        "save_metadata": true,
        "trim_to_audio": false,
        "pingpong": false,
        "save_output": true
      },
      "_meta": {
        "title": "Save H3 video"
      }
    },
    "13": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "storyboards/E1S01_v1_20261016T194612.png"
      },
      "_meta": {
        "title": "ARCREEL:end_image"
      }
    },
    "14": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "34",
          0
        ],
        "lora_name": "电影感loraV1.0正式版.safetensors",
        "strength_model": 0.4
      },
      "_meta": {
        "title": "Cinematic LoRA"
      }
    },
    "15": {
      "class_type": "ModelAttentionBackend",
      "inputs": {
        "model": [
          "14",
          0
        ],
        "attention": "comfy kitchen attention"
      },
      "_meta": {
        "title": "Attention backend"
      }
    },
    "16": {
      "class_type": "BlockSparseAttention",
      "inputs": {
        "model": [
          "15",
          0
        ],
        "start_percent": 0.2,
        "end_percent": 1,
        "dense_blocks": "",
        "min_tokens": 12288,
        "extra_tokens": 256,
        "sink_conditioning": "exact_kv_and_rows",
        "verbose": true,
        "selection": "sol-attn",
        "selection.tau": 1.3
      },
      "_meta": {
        "title": "Block sparse attention"
      }
    },
    "17": {
      "class_type": "ModelPreviewOverrideKJ",
      "inputs": {
        "model": [
          "51",
          0
        ],
        "max_resolution": 1024,
        "jpeg_quality": 80,
        "suppress_default_preview": true,
        "preview_fps": 8,
        "tiny_vae": "none",
        "preview_frames": 48
      },
      "_meta": {
        "title": "Preview override"
      }
    },
    "30": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "lora_name": "MysticXXX_MMH3-V1.safetensors",
        "strength_model": 0.35
      },
      "_meta": {
        "title": "LoRA MysticXXX_MMH3-V1.safetensors"
      }
    },
    "31": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "30",
          0
        ],
        "lora_name": "H3_Combat_V2.safetensors",
        "strength_model": 0.65
      },
      "_meta": {
        "title": "LoRA H3_Combat_V2.safetensors"
      }
    },
    "32": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "31",
          0
        ],
        "lora_name": "Motion_Repair_V2.safetensors",
        "strength_model": 0.35
      },
      "_meta": {
        "title": "LoRA Motion_Repair_V2.safetensors"
      }
    },
    "33": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "32",
          0
        ],
        "lora_name": "H3_Fight_Flow_V1.safetensors",
        "strength_model": 0.35
      },
      "_meta": {
        "title": "LoRA H3_Fight_Flow_V1.safetensors"
      }
    },
    "34": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "33",
          0
        ],
        "lora_name": "motion_speed_slider_mmh3_v1.1.safetensors",
        "strength_model": 0.8
      },
      "_meta": {
        "title": "LoRA motion_speed_slider_mmh3_v1.1.safetensors"
      }
    },
    "40": {
      "class_type": "MiniMaxH3SigmaShift",
      "inputs": {
        "model": [
          "16",
          0
        ],
        "shift_video": 12,
        "shift_audio": 3
      },
      "_meta": {
        "title": "SigmaShift"
      }
    },
    "50": {
      "class_type": "MiniMaxChunkFeedForward",
      "inputs": {
        "chunks": 2,
        "seq_threshold": 4096,
        "model": [
          "40",
          0
        ]
      },
      "_meta": {
        "title": "ChunkFeedForward (VRAM)"
      }
    },
    "51": {
      "class_type": "MiniMaxLowVRAMAttention",
      "inputs": {
        "head_chunks": 4,
        "model": [
          "50",
          0
        ]
      },
      "_meta": {
        "title": "LowVRAMAttention (VRAM)"
      }
    },
    "52": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler"
      },
      "_meta": {
        "title": "Sampler select"
      }
    },
    "53": {
      "class_type": "BasicScheduler",
      "inputs": {
        "scheduler": "simple",
        "steps": 10,
        "denoise": 1,
        "model": [
          "17",
          0
        ]
      },
      "_meta": {
        "title": "Scheduler"
      }
    },
    "54": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": [
          "7",
          0
        ]
      },
      "_meta": {
        "title": "Negative (zeroed)"
      }
    },
    "55": {
      "class_type": "SelfLiftH3Sampler",
      "inputs": {
        "seed": 0,
        "cfg": 1,
        "transition_step": 6,
        "lowres_scale": 0.6000000000000001,
        "rho": 0,
        "w_min": 0.5,
        "w_max": 1,
        "upscaler_model": "h3_upscaler_lms_v0.1.safetensors",
        "highres_tiling": false,
        "upscaler_unload": true,
        "model": [
          "17",
          0
        ],
        "positive": [
          "7",
          0
        ],
        "negative": [
          "54",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "latent_image": [
          "7",
          1
        ],
        "sampler": [
          "52",
          0
        ],
        "sigmas": [
          "53",
          0
        ]
      },
      "_meta": {
        "title": "SelfLift H3 Sampler"
      }
    }
  },
  "bindings": {
    "prompt": [
      {
        "node": "7",
        "input": "prompt",
        "class_type": "MiniMaxH3ImageToVideo",
        "direction": "write"
      }
    ],
    "negative_prompt": [],
    "start_image": [
      {
        "node": "6",
        "input": "image",
        "class_type": "LoadImage",
        "direction": "write"
      }
    ],
    "end_image": [
      {
        "node": "13",
        "input": "image",
        "class_type": "LoadImage",
        "direction": "write"
      }
    ],
    "reference_images": [],
    "width": [
      {
        "node": "7",
        "input": "width",
        "class_type": "MiniMaxH3ImageToVideo",
        "step": 32
      }
    ],
    "height": [
      {
        "node": "7",
        "input": "height",
        "class_type": "MiniMaxH3ImageToVideo",
        "step": 32
      }
    ],
    "frames": [
      {
        "node": "7",
        "input": "length",
        "class_type": "MiniMaxH3ImageToVideo",
        "fps": 24
      }
    ],
    "fps": [
      {
        "node": "12",
        "input": "frame_rate",
        "class_type": "VHS_VideoCombine",
        "direction": "read"
      }
    ],
    "seed": [
      {
        "node": "55",
        "input": "seed",
        "class_type": "SelfLiftH3Sampler",
        "policy": "random"
      }
    ],
    "output": [
      {
        "node": "12",
        "class_type": "VHS_VideoCombine",
        "direction": "write"
      }
    ]
  }
}